# Copy this file to .env.local and change the secret before going live.
#
# Signs the admin session cookie. Any long random string works.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# Optional. Where the SQLite file lives. Defaults to ./db/shop.db
# BAYT_DB_PATH=./db/shop.db
